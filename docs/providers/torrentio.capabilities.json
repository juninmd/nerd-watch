{
  "$comment": "Snapshot de capacidades do Torrentio em 2026-11-20 (addon v0.0.15). Fontes: https://torrentio.strem.fun/manifest.json, https://torrentio.strem.fun/configure e o código de github.com/TheBeastLT/torrentio-scraper (branch master). Serve para montar a configuração e a UI de addons de torrent no futuro; não é consumido em runtime.",
  "addon": {
    "id": "com.stremio.torrentio.addon",
    "version": "0.0.15",
    "name": "Torrentio",
    "types": ["movie", "series", "anime", "other"],
    "resources": ["stream"],
    "resourcesWithDebrid": ["stream", "meta"],
    "idPrefixes": ["tt", "kitsu"],
    "behaviorHints": { "configurable": true, "configurationRequired": false },
    "images": {
      "logo": "https://torrentio.strem.fun/images/logo_v1.png",
      "background": "https://torrentio.strem.fun/images/background_v1.jpg"
    }
  },
  "config": {
    "location": "path",
    "format": "/{chave=valor|chave=valor}/manifest.json",
    "separator": "|",
    "valueSeparator": ",",
    "presets": {
      "lite": {
        "providers": "todos os provedores sem bandeira estrangeira",
        "qualities": ["scr", "cam"],
        "limit": 1
      },
      "brazuca": {
        "providers": "todos os provedores sem bandeira estrangeira + os de bandeira 🇵🇹",
        "languages": ["portuguese"]
      }
    },
    "keys": [
      {
        "key": "providers",
        "values": "lista de chaves de provedor separadas por vírgula",
        "default": "todos",
        "notes": "lista vazia = todos; lista preenchida liga só os citados; não existe sintaxe de exclusão (!provedor não funciona e devolve zero streams)"
      },
      {
        "key": "sort",
        "values": ["quality", "qualitysize", "seeders", "size"],
        "default": "quality"
      },
      {
        "key": "language",
        "values": "lista de idiomas separados por vírgula",
        "default": "sem preferência",
        "notes": "não filtra: coloca os streams com a bandeira do idioma na frente; o resto continua na lista"
      },
      {
        "key": "qualityfilter",
        "values": "lista de qualidades separadas por vírgula",
        "default": "nenhum",
        "notes": "exclui as qualidades listadas; a comparação é exata (1080p não remove '1080p HDR')"
      },
      {
        "key": "limit",
        "values": "inteiro sem zero à esquerda",
        "default": "sem limite de configuração (teto de 500 do banco)",
        "notes": "aplica por balde de qualidade, não ao total"
      },
      {
        "key": "minseeders",
        "values": "inteiro",
        "default": "0",
        "notes": "ignorado quando há chave de debrid configurada"
      },
      {
        "key": "sizefilter",
        "values": "um ou dois tamanhos (ex.: 1GB,10GB)",
        "default": "sem limite",
        "notes": "um valor limita filme e série; dois valores usam o primeiro para filme e o último para série; valor ilegível vira 0 bytes e zera a lista"
      },
      {
        "key": "debridoptions",
        "values": ["nodownloadlinks", "nocatalog"],
        "default": "nenhuma",
        "notes": "nodownloadlinks esconde os links '[XX download]'; nocatalog esconde catálogos e o recurso meta"
      },
      {
        "key": "realdebrid | premiumize | alldebrid | debridlink | easydebrid | offcloud | torbox | putio | highway",
        "values": "token do serviço (put.io usa clientId@token)",
        "default": "vazio",
        "notes": "muda o nome do addon, liga o catálogo de downloads e o recurso meta; token com menos de 15 caracteres ou não imprimível é recusado"
      }
    ]
  },
  "providers": [
    { "key": "yts", "label": "YTS", "group": "general" },
