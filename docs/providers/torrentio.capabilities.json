  "limits": {
    "streamsPerRequest": 500,
    "debridCatalogPage": 100,
    "maxApiKeyBlacklist": 20000,
    "rateLimitRequestsPerDay": 5000,
    "rateLimitRequestsScope": "requisições de stream/catalog/meta por IP; orçamentos de miss/empty usam IPv6 /64",
    "rateLimitMissPer10Min": 100,
    "rateLimitEmptyPer10Min": 30,
    "rateLimitKeyedMultiplier": 3,
    "availabilityTimeoutSeconds": 30,
    "resolveTimeoutSeconds": 120
  },
  "cache": {
    "streamsMaxAgeSeconds": 3600,
    "emptyMaxAgeSeconds": 60,
    "staticVideoMaxAgeSeconds": 0,
    "staleRevalidateSeconds": 14400,
    "staleErrorSeconds": 604800,
    "resolvedRedirectMaxAgeSeconds": 21600,
    "debridCatalogMaxAgeSeconds": 0
