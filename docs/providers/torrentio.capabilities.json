  "streamShape": {
    "fields": ["name", "title", "infoHash", "fileIdx", "sources", "behaviorHints.bingeGroup", "behaviorHints.filename", "behaviorHints.videoSize", "behaviorHints.videoHash", "url"],
    "name": "Torrentio\\n{qualidade [3D] [HDR|DV]}",
    "title": "{título do torrent}\\n{arquivo, se diferente}\\n👤 {seeders} 💾 {tamanho} ⚙️ {provedor}\\n{idiomas/bandeiras}",
    "bingeGroup": "torrentio|{qualidade|fonte|codec|bitDepth|hdr} (filme) ou torrentio|{qualidade|hdr|grupo} / torrentio|{infoHash} (série)",
    "sources": "tracker:{url} por tracker + dht:{infoHash}; torrents de anime e de provedores russos recebem trackers extras"
  },
  "endpoints": [
    { "path": "/", "response": "303 para /configure" },
    { "path": "/configure", "response": "HTML da página de configuração" },
    { "path": "/lite", "response": "303 para /lite/configure" },
    { "path": "/brazuca", "response": "303 para /brazuca/configure" },
    { "path": "/manifest.json", "response": "manifest padrão" },
    { "path": "/{config}/manifest.json", "response": "manifest configurado" },
    { "path": "/{config}/stream/{tipo}/{id}.json", "response": "streams" },
    { "path": "/{config}/catalog/other/{catalogo}.json[/{skip=N}]", "response": "catálogo de downloads do debrid" },
    { "path": "/{config}/meta/other/{moch}:{item}.json", "response": "meta do download, com videos[].streams[]" },
    { "path": "/resolve/{moch}/{api_key}/{info_hash}/{entrada}/{indice}[/{arquivo}]", "response": "302 para o debrid ou vídeo de erro" },
    { "path": "/metrics", "response": "Prometheus com HTTP Basic" },
    { "path": "/videos/*", "response": "vídeos estáticos de erro" }
  ],
  "examples": {
    "manifestWithDebrid": {
      "name": "Torrentio RD",
      "catalogs": [{ "id": "torrentio-realdebrid", "name": "RealDebrid", "type": "other", "extra": [{ "name": "skip" }] }],
      "resources": [
        { "name": "stream", "types": ["movie", "series", "anime"], "idPrefixes": ["tt", "kitsu"] },
        { "name": "meta", "types": ["other"], "idPrefixes": ["realdebrid"] }
