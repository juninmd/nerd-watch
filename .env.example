# Porta do servidor local (Hono/Bun)
PORT=7799

# Chave da TMDB (obrigatória para busca/catálogo de filmes, séries e novelas
# protegidos por direitos autorais). Gere gratuitamente em
# https://www.themoviedb.org/settings/api — v3 auth, "API Key" simples.
# Sem essa chave o app continua funcional: catálogo de domínio público
# (Internet Archive), sua lista e o calendário seguem de pé.
TMDB_API_KEY=

# Idioma e região usados nas respostas da TMDB (sinopses, datas de estreia,
# streamings disponíveis).
TMDB_LANGUAGE=pt-BR
TMDB_REGION=BR

# Caminho do banco SQLite local (sua lista, progresso, notas). Nada sai da
# sua máquina além das chamadas às APIs de catálogo.
DB_PATH=data/nerd-watch.db
