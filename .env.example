# Porta do servidor local (Hono/Bun)
PORT=7799

# Chave da TMDB (obrigatória para busca/catálogo de filmes, séries e novelas
# protegidos por direitos autorais). Gere gratuitamente em
# https://www.themoviedb.org/settings/api — v3 auth, "API Key" simples.
# Sem essa chave o app continua funcional: catálogo de domínio público
# (Internet Archive), sua lista e o calendário seguem de pé.
TMDB_API_KEY=

# Idioma e região usados nas respostas da TMDB (sinopses, datas de estreia,
# streamings disponíveis).
TMDB_LANGUAGE=pt-BR
TMDB_REGION=BR

# Caminho do banco SQLite local (sua lista, progresso, notas). Nada sai da
# sua máquina além das chamadas às APIs de catálogo.
DB_PATH=data/nerd-watch.db

# Chave da OpenSubtitles (OPCIONAL). A busca de legenda NÃO depende mais dela: o padrão é o addon
# OpenSubtitles v3 do Stremio (ver SUBTITLE_ADDONS abaixo), que não pede chave nenhuma. Esta chave
# só soma uma segunda fonte, com cota de downloads por dia.
# A antiga API sem chave (opensubtitles.org XML-RPC) foi desligada em 2026. Para gerar a sua:
# crie uma conta e gere em https://www.opensubtitles.com/pt/consumers.
OPENSUBTITLES_API_KEY=

# Idiomas de legenda aceitos, na ordem de preferência. Vale para as duas fontes.
OPENSUBTITLES_LANGUAGES=pt-BR,pt,en

# Addons de legenda no protocolo do Stremio (o mesmo sistema de addons daquele app), separados por
# vírgula. O padrão é o addon oficial OpenSubtitles v3 e NÃO precisa de chave nem de cadastro.
# Um addon só é usado se o manifesto dele declarar o recurso `subtitles` e aceitar id do IMDb.
# A busca depende de traduzir o id da TMDB para o id do IMDb (feito automaticamente).
SUBTITLE_ADDONS=https://opensubtitles-v3.strem.io

# Engine de torrent P2P (opcional — ligada por padrão).
# Serve dois caminhos: o player P2P do Internet Archive (o app monta a URL do .torrent a partir do
# `identifier` do item) e a fonte "Torrent" de Conexões, que aceita o magnet ou a URL .torrent que VOCÊ cola
# (regras e limites em docs/providers/torrent.md). O app não busca, não indexa e não traz lista de trackers.
# Desligue com TORRENT_ENABLED=false se não quiser P2P nenhum.
TORRENT_ENABLED=true

# Onde ficam os pedaços baixados (ficam no .gitignore). O torrent é destruído por ociosidade;
# nada fica semeando depois que você fecha a aba.
TORRENT_PATH=.cache/torrents

# Teto de upload em KB/s enquanto você assiste. NÃO use 0: no webtorrent 0 é throttle de zero
# byte/s (bloqueia upload e os peers param de te servir). -1 é que é "sem limite".
TORRENT_UPLOAD_LIMIT_KB=100

TORRENT_MAX_CONNECTIONS=55
# Quantos torrents podem ficar abertos ao mesmo tempo (o mais antigo é fechado acima disso).
TORRENT_MAX_ACTIVE=3
# Sem leitura por esse tempo, o torrent é destruído e o disco liberado.
TORRENT_IDLE_MINUTES=10
# Quanto esperar a metadata do torrent antes de desistir de achar peers.
TORRENT_METADATA_TIMEOUT_SECONDS=45

# Token do bot do Telegram (opcional, modo "bot" de canais em /telegram).
# Crie um bot grátis com o @BotFather e adicione ele como admin do(s)
# canal(is) que quiser rastrear. Limitações reais da Bot API, não dá pra
# contornar sem infraestrutura extra:
# - só vê posts a partir do momento em que o bot foi adicionado (sem
#   histórico retroativo — isso só existe na Client API/MTProto);
# - arquivos maiores que 20MB não baixam pela API na nuvem; hoje o app não
#   contorna isso (não provisionamos um `telegram-bot-api` self-hosted por
#   conta própria) — pra vídeo grande, use o modo "público" ou "conta
#   pessoal" nesse mesmo canal.
# Sem esse token, o app segue funcional: canais em modo "público" continuam
# funcionando sem nenhuma credencial.
TELEGRAM_BOT_TOKEN=

# Conta pessoal do Telegram (opcional, modo "conta pessoal" de canais em /telegram).
# É o único modo sem teto de 20MB por vídeo, e estruturalmente o único capaz de buscar
# histórico completo (a Bot API não tem getChatHistory) — hoje ainda importa só os
# vídeos mais recentes, igual aos outros modos (paginação de histórico mais antigo
# ainda não está implementada). Passos:
# 1. Crie um app em https://my.telegram.org (aba "API development tools") e copie
#    api_id/api_hash — pode colar direto em /telegram → "Configurar credenciais",
#    ou preencher aqui embaixo (TELEGRAM_API_ID/TELEGRAM_API_HASH).
# 2. Login único: o mais simples é o botão "entrar com QR code" na mesma tela
#    (escaneia com o Telegram do celular, sem digitar telefone/código no app).
#    Alternativa via terminal: `bun run telegram:login`. Os dois gravam a
#    session resultante em TELEGRAM_SESSION — nunca digitada nem exibida por HTTP.
# Trate TELEGRAM_SESSION como senha da sua conta: dá acesso completo a ela.
# Sem essas 3 variáveis, o app segue funcional: modos "público" e "bot" continuam
# disponíveis.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Google Drive (OPCIONAL): assista aos vídeos de pastas do SEU Drive, com fila e "continuar assistindo".
# 1. No Google Cloud Console: crie um projeto, ative a Google Drive API, publique a tela de consentimento
#    OAuth ("Em produção" — em "Teste" a autorização expira a cada 7 dias) e crie um ID do cliente
#    OAuth do tipo "App para computador". Pode preencher pela UI (Conexões) em vez daqui.
# 2. Conectar: botão "Conectar ao Google Drive" em Conexões (acesso SOMENTE LEITURA, escopo drive.readonly).
#    O refresh token resultante vai para GOOGLE_DRIVE_REFRESH_TOKEN — trate como senha, nunca versione.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# --- Fontes de vídeo (todas OPCIONAIS; configure em Conexões ou aqui). Segredos: nunca versione este arquivo. ---
# Pasta local: pastas que o app pode listar (separadas por ';' no Windows e ':' no Linux/macOS).
# Só o .env altera esta lista (a UI não grava): ela é a permissão de leitura do seu disco.
LOCAL_MEDIA_DIRS=

# WebDAV (Nextcloud, ownCloud, NAS). Use senha de aplicativo.
WEBDAV_URL=
WEBDAV_USER=
WEBDAV_PASSWORD=

# S3 compatível (AWS, MinIO, Backblaze B2, Cloudflare R2). Crie uma chave só de leitura.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Dropbox (OAuth PKCE, sem secret). O refresh token é gravado aqui ao conectar — trate como senha.
DROPBOX_APP_KEY=
DROPBOX_REFRESH_TOKEN=

# OneDrive pessoal (OAuth PKCE, sem secret). O refresh token é gravado aqui ao conectar — trate como senha.
ONEDRIVE_CLIENT_ID=
ONEDRIVE_REFRESH_TOKEN=

# Jellyfin / Emby e Plex (servidor na sua rede). Chave/token dão acesso amplo ao servidor: guarde como senha.
JELLYFIN_URL=
JELLYFIN_API_KEY=
PLEX_URL=
PLEX_TOKEN=

# Trakt (importar o que você já assistiu). Crie o app em trakt.tv/oauth/applications.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_REFRESH_TOKEN=
